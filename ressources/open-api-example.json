{
  "openapi": "3.1.0",
  "info": {
    "title": "Matrix Bot",
    "version": "1.0.0"
  },
  "paths": {
    "/matrix/message": {
      "post": {
        "summary": "Send a message to a room",
        "responses": {
          "200": {
            "description": "Successful response"
          }
        },
        "operationId": "Send_a_message_to_a_room",
        "requestBody": {
          "content": {
            "application/json": {
              "example": "{\n\t\"roomId\": \"room123\",\n\t\"message\": \"This is a test\",\n}"
            }
          }
        }
      }
    },
    "/health": {
      "get": {
        "summary": "Health",
        "responses": {
          "200": {
            "description": "Successful response"
          }
        },
        "operationId": "Health",
        "tags": ["Metrics"]
      }
    },
    "/metrics": {
      "get": {
        "summary": "Metrics",
        "responses": {
          "200": {
            "description": "Successful response"
          }
        },
        "operationId": "Metrics",
        "tags": ["Metrics"]
      }
    }
  },
  "servers": [
    {
      "url": "<<matrix-bot-url>>"
    }
  ],
  "tags": [
    {
      "name": "Metrics"
    }
  ],
  "x-hoppscotch-folder-tags": "slash",
  "security": [
    {
      "apiKey_header_x-api-key": []
    }
  ],
  "components": {
    "securitySchemes": {
      "apiKey_header_x-api-key": {
        "type": "apiKey",
        "in": "header",
        "name": "x-api-key"
      }
    }
  }
}
