{
  "name": "matrix-bot",
  "version": "1.0.1",
  "description": "A matrix bot that forwards the message to an other microservice",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "ssh://git@gitlab.yauseyenka.de/internal/micro-services/matrix-bot.git"
  },
  "author": "Andrei Yauseyenka",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/server.js",
    "dev": "ts-node src/server.ts",
    "lint": "oxlint .",
    "lint:fix": "oxlint . --fix",
    "format": "oxfmt --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/auto-instrumentations-node": "^0.79.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.221.0",
    "@opentelemetry/sdk-node": "^0.221.0",
    "@pyroscope/nodejs": "^0.6.1",
    "@vector-im/matrix-bot-sdk": "^0.9.0-element.1",
    "express": "^5.2.1",
    "pino": "^10.3.1",
    "pino-loki": "^3.0.0",
    "pino-pretty": "^13.1.3",
    "prom-client": "^15.1.3"
  },
  "allowScripts": {
    "@matrix-org/matrix-sdk-crypto-nodejs@0.6.1": true,
    "@datadog/pprof@5.14.4": true,
    "protobufjs@7.6.5": true
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.1.1",
    "@types/supertest": "^7.2.1",
    "@vitest/coverage-v8": "^4.1.10",
    "oxfmt": "^0.60.0",
    "oxlint": "^1.75.0",
    "oxlint-tsgolint": "^7.0.2001",
    "supertest": "^7.2.2",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
