{
  "name": "matrix-bot",
  "version": "0.0.2",
  "description": "A matrix bot that forwards the message to an other microservice",
  "repository": {
    "type": "git",
    "url": "ssh://git@gitlab.yauseyenka.de/internal/micro-services/matrix-bot.git"
  },
  "author": "Andrei Yauseyenka",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/server.js",
    "dev": "ts-node src/server.ts",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@vector-im/matrix-bot-sdk": "^0.9.0-element.1",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/auto-instrumentations-node": "^0.78.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.220.0",
    "@opentelemetry/sdk-node": "^0.220.0",
    "@pyroscope/nodejs": "^0.6.1",
    "express": "^5.2.1",
    "pino": "^10.3.1",
    "pino-loki": "^3.0.0",
    "pino-pretty": "^13.1.3",
    "prom-client": "^15.1.3"
  },
  "allowScripts": {
    "@matrix-org/matrix-sdk-crypto-nodejs@0.6.1": true,
    "@datadog/pprof@5.14.4": true,
    "protobufjs@7.6.5": true
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/express": "^5.0.6",
    "@types/node": "^26.1.1",
    "@types/supertest": "^7.2.1",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^10.7.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "prettier": "^3.9.5",
    "supertest": "^7.2.2",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.64.0",
    "vitest": "^4.1.10"
  }
}
