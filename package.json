{
  "name": "matrix-bot",
  "version": "1.1.3",
  "description": "A matrix bot that forwards the message to an other microservice",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "ssh://git@gitlab.yauseyenka.de/internal/micro-services/matrix-bot.git"
  },
  "author": "Andrei Yauseyenka",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "clean": "rm -rf coverage dist node_modules package-lock.json",
    "build:local": "npm i && tsc",
    "build": "tsc",
    "start": "node --import ./dist/instrumentation.js dist/server.js",
    "lint": "oxlint .",
    "lint:fix": "oxlint . --fix",
    "format": "oxfmt --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@vector-im/matrix-bot-sdk": "^0.9.0-element.1",
    "@yauseyea/node-observability": "^1.0.1",
    "express": "^5.2.1",
    "prom-client": "^15.1.3"
  },
  "allowScripts": {
    "@matrix-org/matrix-sdk-crypto-nodejs@0.6.1": true,
    "@datadog/pprof@5.14.4": true,
    "protobufjs@7.6.5": true
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.1.1",
    "@types/supertest": "^7.2.1",
    "@vitest/coverage-v8": "^4.1.10",
    "@yauseyea/oxlint-config": "^1.0.4",
    "oxfmt": "^0.60.0",
    "oxlint": "^1.75.0",
    "supertest": "^7.2.2",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
